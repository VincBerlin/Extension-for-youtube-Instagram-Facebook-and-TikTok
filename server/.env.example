PORT=3001

# ─── CORS allowlists ──────────────────────────────────────────────────────────
# Comma-separated Chrome Web Store extension IDs (32 lowercase letters a-p).
# Leave UNSET for local dev — any chrome-extension:// origin is allowed.
# In production you MUST set this to your published Web Store ID so other
# extensions can't call your API.
ALLOWED_EXTENSION_IDS=

# Comma-separated http(s) origins for non-extension callers (web app,
# marketing site). Used in addition to the extension allowlist above.
ALLOWED_ORIGINS=

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Supported: gemini | openai | anthropic (default: gemini)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash

# Get your free Gemini API key at: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe (only needed for paid subscriptions) ──────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
APP_URL=https://your-deployed-server.onrender.com
