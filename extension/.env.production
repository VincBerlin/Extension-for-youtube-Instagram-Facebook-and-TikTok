# REQUIRED: the deployed server URL (https://...) — used by every production
# build (`npm run build`, `npm run release:zip`). The build FAILS while this
# is unset or points at localhost (guard in vite.config.ts), because a store
# build with a localhost API base is dead on arrival for every user.
#
# Note: this file overrides .env in production-mode builds. Local development
# uses `npm run dev` (development mode), which reads .env instead.
VITE_API_BASE=
